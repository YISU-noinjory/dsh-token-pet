{
  "//": "基础配置：仅供 `npm run typecheck` 做全量类型检查，不产出文件。",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "vite.config.ts", "vite.preload.config.ts", "vite.dsh.config.ts"],
  "//exclude": "src/dsh 依赖 @deepseek-ai/* peer 依赖，需要装有 DSH 的环境才能解析，见 tsconfig.dsh.json。",
  "exclude": ["src/dsh"]
}
